    "@capacitor/preferences": "^8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "retell-client-js-sdk": "^3.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
