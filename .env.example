# Copy to .env and fill in. Never commit .env.
PORT=8787
PUBLIC_BASE_URL=https://your-tunnel.example.com      # ngrok/cloudflared URL Retell can reach
RETELL_API_KEY=                                      # from the Retell dashboard; read by provision_retell.js only
RETELL_WEBHOOK_SECRET=                               # leave empty: Retell signs x-retell-signature with the API key (verified in retell-sdk 6.2.7 webhook_auth)
ECHOHAWK_SALT=change-me                              # salts the independence key
ECHOHAWK_FRAME_KEY=change-me-too                     # HMAC key for the 16-byte chirp frame
ANTHROPIC_API_KEY=                                   # Claude API key (console.anthropic.com); when set, Claude handles replies, extraction, translation
ANTHROPIC_WORKSPACE_ID=                              # only if your Claude key is not scoped to a workspace (Console > Workspaces, wrkspc_...)
LLM_BASE_URL=                                        # OpenAI-compatible chat completions base, e.g. https://api.openai.com/v1 (optional)
LLM_API_KEY=                                         # optional; without it the server uses rule-based responses
LLM_MODEL=                                           # optional; default claude-haiku-5-5 with Claude, gpt-4o-mini otherwise
PAID_CONCURRENCY=20
DISPATCHER_TOKEN=dev-dispatcher
SUPERVISOR_TOKEN=dev-supervisor
# Public Alerts sign-in passcode for agency accounts (OEM, Sheriff, Fire, LAPD, LAFD, EMD)
AGENCY_TOKEN=dev-agency

# Connected resident pilot (live calls off until explicitly configured)
RESIDENT_LIVE_ENABLED=false
RETELL_AGENT_ID=
RESIDENT_ACCESS_CODE=
# Gateway-only bearer secret, shared with the radio gateway process
RELAY_GATEWAY_TOKEN=
